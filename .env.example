# Copy this file to .env and fill in real values. Never commit .env itself.
# Quote every value — some (like a database URL) contain shell-special characters like &.

# --- Google OAuth (Phase 0.1) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- MySQL (only for a hosted database; local runs use the `local` profile) ---
DB_URL="jdbc:mysql://<host>:3306/<db>"
DB_USERNAME=""
DB_PASSWORD=""

# --- Supabase Storage / S3-compatible (Phase 0.3) ---
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="content"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- App-level secrets ---
# Seeded admin emails, comma-separated. Your own Google account email goes here.
APP_ADMIN_EMAILS=""
# Random 32+ byte secret for signing stream tickets. Generate with:
#   openssl rand -base64 32
APP_TICKET_SECRET=""

# --- AI question generation (optional) ---
# Groq's free tier works (get a key at console.groq.com). Any OpenAI-compatible provider does; pick a
# current model name from your provider's model list.
AI_API_KEY=""
AI_MODEL=""
# AI_BASE_URL="https://api.groq.com/openai/v1"


# --- Redis and RabbitMQ (optional; start them with `docker compose up -d redis rabbitmq`) ---
# With both left off, sessions live in MySQL and AI generation runs on a thread pool inside the app.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=secureportal
RABBITMQ_PASSWORD=secureportal
# Set to false to turn the per-user request limits off (they're on by default).
RATE_LIMIT_ENABLED=true
# How long the admin dashboard's numbers are cached, in seconds (0 = never).
ANALYTICS_CACHE_SECONDS=60

# --- Object storage and video processing (optional; `docker compose up -d s3`) ---
# STORAGE_PROVIDER=s3, STORAGE_ENDPOINT=http://localhost:8333, STORAGE_BUCKET=content,
# STORAGE_ACCESS_KEY=minioadmin, STORAGE_SECRET_KEY=minioadmin
STORAGE_CREATE_BUCKET=true
# Adaptive streaming: turn off, or point at ffmpeg/ffprobe (scripts/ffmpeg-docker.sh runs them in Docker).
TRANSCODE_ENABLED=true
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Prefix for RabbitMQ queue names, so two copies of the app on one broker don't share jobs.
QUEUE_PREFIX=

# How long the public leaderboard's top list is cached, in seconds (0 = never).
LEADERBOARD_CACHE_SECONDS=30
