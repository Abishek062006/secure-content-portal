# Copy this file to .env and fill in real values. Never commit .env itself.
# Quote every value — some (like a database URL) contain shell-special characters like &.

# --- Google OAuth (Phase 0.1) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- MySQL (only for a hosted database; local runs use the `local` profile) ---
DB_URL="jdbc:mysql://<host>:3306/<db>"
DB_USERNAME=""
DB_PASSWORD=""

# --- Supabase Storage / S3-compatible (Phase 0.3) ---
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="content"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# --- App-level secrets ---
# Seeded admin emails, comma-separated. Your own Google account email goes here.
APP_ADMIN_EMAILS=""
# Random 32+ byte secret for signing stream tickets. Generate with:
#   openssl rand -base64 32
APP_TICKET_SECRET=""

# --- AI question generation (optional) ---
# Groq's free tier works (get a key at console.groq.com). Any OpenAI-compatible provider does; pick a
# current model name from your provider's model list.
AI_API_KEY=""
AI_MODEL=""
# AI_BASE_URL="https://api.groq.com/openai/v1"

