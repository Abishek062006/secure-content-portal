{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://secure-content-portal.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://secure-content-portal.onrender.com/oauth2/:path*" },
    { "source": "/login/:path*", "destination": "https://secure-content-portal.onrender.com/login/:path*" },
    { "source": "/logout", "destination": "https://secure-content-portal.onrender.com/logout" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
